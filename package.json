{
	"name": "obsidian-table-column-resizer",
	"version": "1.2.0",
	"description": "Drag to resize table columns in Obsidian reading view",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/browser.test.cjs",
		"benchmark": "node scripts/benchmark.cjs",
		"package": "node scripts/package.cjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"table",
		"column",
		"resize"
	],
	"author": "bubble (upstream); WNGjeanm (performance fork)",
	"repository": { "type": "git", "url": "https://github.com/WNGjeanm/obsidian-table-column-resizer.git" },
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "^5.4.5",
		"playwright": "1.62.1",
		"jszip": "3.10.1"
	}
}
